# Conexión a PostgreSQL local.
# Reemplaza TU_CONTRASEÑA por la contraseña del usuario "postgres" que pusiste al instalar PostgreSQL.
DATABASE_URL="postgresql://postgres:TU_CONTRASEÑA@localhost:5432/cabana_primavera?schema=public"

# Puerto del backend (Angular usa 4200 en desarrollo)
PORT=3001

# Dirección de la web: origen permitido (CORS) y a donde Wompi devuelve al cliente después de pagar.
# En desarrollo usa cabana.localhost: Wompi bloquea (error 403) las direcciones "localhost" y "127.0.0.1".
FRONTEND_URL="http://cabana.localhost:4200"

# Pagos con Wompi. Llaves en el dashboard de Wompi: Desarrolladores → Secretos para integración técnica.
# Para pruebas usa las de Sandbox (pub_test_..., test_integrity_..., test_events_...).
# ⚠️ Nunca subas el archivo .env a GitHub ni compartas estos valores.
WOMPI_LLAVE_PUBLICA=""
WOMPI_SECRETO_INTEGRIDAD=""
WOMPI_SECRETO_EVENTOS=""
